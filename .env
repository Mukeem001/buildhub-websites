# ===========================
# Application
# ===========================
NODE_ENV=production
PORT=5000

# ===========================
# Certbot / SSL
# ===========================
CERTBOT_ENABLED=true
CERTBOT_EMAIL=mohdmukeem9971@gmail.com
# Run certbot as root (passwordless sudo required for the backend user)
CERTBOT_COMMAND="sudo -n /usr/bin/certbot"
CERTBOT_WEBROOT_PATH=/var/www/buildhub-websites/certbot
CERTBOT_USE_NGINX=false
CERTBOT_FALLBACK_TO_WEBROOT=true

NGINX_TEST_COMMAND="sudo -n /usr/sbin/nginx -t"
NGINX_RELOAD_COMMAND="sudo -n /usr/bin/systemctl reload nginx"
NGINX_SITES_AVAILABLE_PATH=/etc/nginx/sites-available
NGINX_SITES_ENABLED_PATH=/etc/nginx/sites-enabled

# ===========================
# URLs
# ===========================
FRONTEND_URL=http://2.28.13.238,http://developermukeem.online,https://developermukeem.online
ALLOWED_ORIGINS=http://2.28.13.238,http://localhost:5173,http://localhost:5174,http://arafaat.developermukeem.online,http://developermukeem.online,https://developermukeem.online
BACKEND_URL=http://2.28.13.238/api

# ===========================
# MongoDB
# ===========================
MONGODB_URI=mongodb+srv://mohdmukeem01:Max01maxico@cluster0.alsuz.mongodb.net/buildhub?retryWrites=true&w=majority

# ===========================
# JWT
# ===========================
JWT_SECRET=Replace_This_With_A_Very_Long_Random_Secret_Key
JWT_EXPIRES_IN=7d

# ===========================
# Email
# ===========================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=BuildHub <noreply@buildhub.com>

# ===========================
# Cloudflare
# ===========================
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# ===========================
# File Upload
# ===========================
MAX_FILE_SIZE=10485760

# ===========================
# Publish
# ===========================
DEFAULT_SUBDOMAIN=buildhub.site
PUBLISH_ROOT=/var/www/buildhub-websites/published

# ===========================
# Admin
# ===========================
ADMIN_EMAIL=admin@buildhub.com
